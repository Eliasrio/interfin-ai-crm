{
  "title": "Worker Health",
  "uid": "worker-health",
  "tags": ["interfin", "m11"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Dead letter (state=dead)",
      "description": "SRS §6.3: задачи, исчерпавшие 3 ретрая. Алерт DeadLetterQueueGrowing",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ] }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(asynq_queue_size{state=\"dead\"})", "legendFormat": "dead" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Очередь по состояниям",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum by (state) (asynq_queue_size)", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Длительность задач p95 по типам",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, task_type) (rate(asynq_task_duration_seconds_bucket[5m])))", "legendFormat": "{{task_type}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Задачи/с: ok vs error",
      "description": "error = попытка кончилась ретраем либо dead letter (§6.3: backoff 2/8/32с)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum by (status) (rate(asynq_task_duration_seconds_count[5m]))", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
