# Interfin AI-CRM — шаблон переменных окружения (SRS §12).
# Скопируй в .env и заполни. РЕАЛЬНЫЕ значения в git не коммитятся (CLAUDE.md §4.9).

# --- Server ---
HTTP_PORT=8080
CONFIG_PATH=config/config.yaml

# --- Telegram (M2, все три обязательные) ---
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Секрет для X-Telegram-Bot-Api-Secret-Token (§5.4): 1–256 символов
# A-Za-z0-9_- . Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# ПОЛНЫЙ публичный HTTPS-URL вплоть до пути, например:
# https://<домен-или-ngrok>/webhook/telegram (см. README, «Telegram webhook локально»)
TELEGRAM_WEBHOOK_URL=

# --- PostgreSQL (обязательная) ---
# dev-пример: postgres://postgres:postgres@localhost:5432/interfin?sslmode=disable
POSTGRES_DSN=

# --- Redis (обязательная; dev-пример: localhost:6379) ---
REDIS_ADDR=
REDIS_PASSWORD=

# --- Auth: JWT RS256 (M7) ---
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# --- Claude API (M3, обязательная) ---
ANTHROPIC_API_KEY=
# Опционально: Telegram chat_id менеджера для алертов dead letter (§6.3).
# Пусто = алерты только в лог.
TELEGRAM_MANAGER_CHAT_ID=

# --- Voyage AI embeddings (M4, AQ²-fix #2, обязательная) ---
# Ключ https://voyageai.com — RAG-эмбеддинги voyage-3. OPENAI_API_KEY НЕ нужен.
VOYAGE_API_KEY=

# --- CryptoBot Crypto Pay API (M6, токены обязательные) ---
# Токены приложений Crypto Pay: mainnet — @CryptoBot → Crypto Pay → Create App,
# testnet — @CryptoTestnetBot (тот же путь). Токен = материал HMAC-ключа
# вебхука (§5.5): подпись проверяется ключом SHA256(активный токен).
CRYPTOBOT_TESTNET_TOKEN=
CRYPTOBOT_MAINNET_TOKEN=
# Переключатель сети: true — testnet (разработка), false — mainnet (боевой).
# Не задан → true (безопасный дефолт).
CRYPTOBOT_USE_TESTNET=true

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Monitoring (M11) ---
ALERTMANAGER_URL=

# --- Migrations (cmd/migrate) ---
MIGRATIONS_PATH=./migrations
