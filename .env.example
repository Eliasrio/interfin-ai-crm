# Interfin AI-CRM — шаблон переменных окружения (SRS §12).
# Скопируй в .env и заполни. РЕАЛЬНЫЕ значения в git не коммитятся (CLAUDE.md §4.9).

# --- Server ---
HTTP_PORT=8080
CONFIG_PATH=config/config.yaml

# --- Telegram (M2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# --- PostgreSQL (обязательная) ---
# dev-пример: postgres://postgres:postgres@localhost:5432/interfin?sslmode=disable
POSTGRES_DSN=

# --- Redis (обязательная; dev-пример: localhost:6379) ---
REDIS_ADDR=
REDIS_PASSWORD=

# --- Auth: JWT RS256 (M7) ---
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# --- Claude API (M3) ---
ANTHROPIC_API_KEY=

# --- Voyage AI embeddings (M4, AQ²-fix #2) ---
VOYAGE_API_KEY=

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Monitoring (M11) ---
ALERTMANAGER_URL=

# --- Migrations (cmd/migrate) ---
MIGRATIONS_PATH=./migrations
